--backlog_wait_time 60000
#Кастомные правила:
# - Мониторинг попыток входа (SSH, локальный вход, PAM)
# - Отслеживание изменений учетных записей (/etc/passwd, /etc/shadow)
# - Обнаружение несанкционированного доступа к /etc (ошибки EACCES/EPERM)
-w /var/log/auth.log -p wa -k auth_monitor
-w /etc/pam.d -p wa -k pam_config
-w /usr/sbin/sshd -p x -k sshd_exec
-w /etc/passwd -p wa -k account_changes
-w /etc/shadow -p wa -k account_changes
-w /var/log/auth.log -p wa -k ssh_auth
-w /var/log/secure -p wa -k ssh_auth
-w /etc/pam.d/sshd -p wa -k ssh_auth
-w /etc/pam.d/system-auth -p wa -k pam_config
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/passwd -p wa -k user_changes
-w /etc/shadow -p wa -k user_changes
-w /etc/group -p wa -k user_changes
-a always,exit -F arch=b64 -S open,openat -F dir=/etc -F exit=-EACCES -k unauthorized_access
-a always,exit -F arch=b64 -S open,openat -F dir=/etc -F exit=-EPERM -k unauthorized_access
-w /etc/audit/ -p wa -k audit_config
-e 1
